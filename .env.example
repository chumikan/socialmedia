# Generate URL-safe random values. Do not commit .env.
POSTGRES_PASSWORD=replace-with-random-hex
S3_ACCESS_KEY=local-sns
S3_SECRET_KEY=replace-with-random-hex
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional Google OIDC callback: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional trusted local SMTP relay (for example mailpit:1025)
SMTP_ADDR=
SMTP_FROM=
SMTP_TO=
